{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoryDocument",
  "description": "Scrolltastic renderer contract 0.1 through 0.4. Unsupported capabilities are rejected.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "0.1",
        "0.2",
        "0.3",
        "0.4"
      ],
      "description": "Version 0.2 adds scroll reveals; version 0.3 adds shaped Mask Frames and pull-focus; version 0.4 adds static standard Card Frames."
    },
    "body": {
      "$ref": "#/definitions/Body"
    }
  },
  "required": [
    "version",
    "body"
  ],
  "additionalProperties": false,
  "definitions": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "Length": {
      "type": "string",
      "pattern": "^(?:0|(?:[0-9]+(?:\\.[0-9]+)?)(?:px|rem|vw|vh|svh|dvh))$"
    },
    "Size": {
      "type": "string",
      "pattern": "^(?:0|(?:[0-9]+(?:\\.[0-9]+)?)(?:px|rem|vw|vh|svh|dvh|%))$"
    },
    "Offset": {
      "type": "string",
      "pattern": "^(?:0|-?(?:[0-9]+(?:\\.[0-9]+)?)(?:px|rem|vw|vh|svh|dvh|%))$"
    },
    "Asset": {
      "type": "string",
      "pattern": "^assets/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(?:svg|png|jpg|jpeg|webp|avif)$"
    },
    "Position": {
      "type": "object",
      "properties": {
        "anchor": {
          "type": "string",
          "enum": [
            "top-left",
            "top",
            "top-right",
            "left",
            "center",
            "right",
            "bottom-left",
            "bottom",
            "bottom-right"
          ]
        },
        "x": {
          "$ref": "#/definitions/Offset"
        },
        "y": {
          "$ref": "#/definitions/Offset"
        },
        "width": {
          "$ref": "#/definitions/Size"
        },
        "height": {
          "anyOf": [
            {
              "$ref": "#/definitions/Size"
            },
            {
              "type": "string",
              "const": "auto"
            }
          ]
        },
        "z": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "anchor"
      ],
      "additionalProperties": false
    },
    "Height": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "auto"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "content"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "viewport"
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "fixed"
            },
            "value": {
              "$ref": "#/definitions/Length"
            }
          },
          "required": [
            "mode",
            "value"
          ],
          "additionalProperties": false
        }
      ],
      "type": "object",
      "discriminator": {
        "propertyName": "mode"
      }
    },
    "BackgroundFrame": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "flow": {
          "type": "string",
          "const": "overlay"
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "type": {
          "type": "string",
          "const": "background"
        },
        "asset": {
          "$ref": "#/definitions/Asset"
        },
        "fit": {
          "type": "string",
          "enum": [
            "cover",
            "contain"
          ]
        }
      },
      "required": [
        "type",
        "asset"
      ],
      "additionalProperties": false
    },
    "ImageFrame": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "flow": {
          "type": "string",
          "enum": [
            "normal",
            "overlay",
            "overflow"
          ]
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "type": {
          "type": "string",
          "const": "image"
        },
        "asset": {
          "$ref": "#/definitions/Asset"
        },
        "alt": {
          "type": "string"
        },
        "aspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fit": {
          "type": "string",
          "enum": [
            "contain",
            "cover",
            "width"
          ]
        }
      },
      "required": [
        "type",
        "asset",
        "alt",
        "aspectRatio"
      ],
      "additionalProperties": false
    },
    "NarrativeFrame": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "flow": {
          "type": "string",
          "enum": [
            "normal",
            "overlay",
            "overflow"
          ]
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "type": {
          "type": "string",
          "const": "narrative"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "shape": {
          "type": "string",
          "const": "oblong"
        },
        "scrollAnimation": {
          "$ref": "#/definitions/RevealAnimation"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "DialogueFrame": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "flow": {
          "type": "string",
          "enum": [
            "normal",
            "overlay",
            "overflow"
          ]
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "type": {
          "type": "string",
          "const": "dialogue"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "shape": {
          "type": "string",
          "const": "fat-circle"
        },
        "scrollAnimation": {
          "$ref": "#/definitions/RevealAnimation"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "Frame": {
      "oneOf": [
        {
          "$ref": "#/definitions/BackgroundFrame"
        },
        {
          "$ref": "#/definitions/ImageFrame"
        },
        {
          "$ref": "#/definitions/NarrativeFrame"
        },
        {
          "$ref": "#/definitions/DialogueFrame"
        },
        {
          "$ref": "#/definitions/MaskFrame"
        },
        {
          "$ref": "#/definitions/CardFrame"
        }
      ],
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      }
    },
    "Panel": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "panel"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "height": {
          "$ref": "#/definitions/Height"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Frame"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "id",
        "frames"
      ],
      "additionalProperties": false
    },
    "Space": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "space"
        },
        "height": {
          "$ref": "#/definitions/Length"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "type",
        "height"
      ],
      "additionalProperties": false
    },
    "Container": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "container"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "seam": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "seamless"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "flow": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/Panel"
              },
              {
                "$ref": "#/definitions/Space"
              }
            ],
            "type": "object",
            "discriminator": {
              "propertyName": "type"
            }
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "id",
        "flow"
      ],
      "additionalProperties": false
    },
    "Body": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "orientation": {
          "type": "string",
          "const": "portrait"
        },
        "motion": {
          "type": "object",
          "properties": {
            "reducedMotion": {
              "type": "string",
              "const": "respect-system"
            }
          },
          "required": [
            "reducedMotion"
          ],
          "additionalProperties": false
        },
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Container"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "title",
        "containers"
      ],
      "additionalProperties": false
    },
    "RevealAnimation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "reveal"
        },
        "start": {
          "type": "string",
          "enum": [
            "top bottom",
            "top 90%",
            "top 82%",
            "top 70%",
            "top 55%",
            "top center"
          ]
        },
        "end": {
          "type": "string",
          "enum": [
            "top 90%",
            "top 82%",
            "top 70%",
            "top 55%",
            "top center",
            "bottom top"
          ]
        },
        "from": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "yPercent": {
              "type": "number",
              "minimum": -12,
              "maximum": 12
            },
            "scale": {
              "type": "number",
              "minimum": 0.9,
              "maximum": 1.1
            }
          }
        }
      },
      "required": [
        "type"
      ]
    },
    "MaskShape": {
      "oneOf": [
        {
          "$ref": "#/definitions/EllipseMaskShape"
        },
        {
          "$ref": "#/definitions/RoundedRectMaskShape"
        },
        {
          "$ref": "#/definitions/PolygonMaskShape"
        }
      ],
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      }
    },
    "EllipseMaskShape": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ellipse"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "RoundedRectMaskShape": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "rounded-rect"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "PolygonMaskShape": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "polygon"
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "required": [
        "type",
        "points"
      ],
      "additionalProperties": false
    },
    "MaskFocusTransition": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pull-focus"
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "MaskFrame": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "flow": {
          "type": "string",
          "const": "overlay"
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "type": {
          "type": "string",
          "const": "mask"
        },
        "shape": {
          "$ref": "#/definitions/MaskShape"
        },
        "content": {
          "type": "object",
          "properties": {
            "asset": {
              "$ref": "#/definitions/Asset"
            },
            "alt": {
              "type": "string"
            },
            "fit": {
              "type": "string",
              "enum": [
                "cover",
                "contain"
              ]
            },
            "focus": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "asset",
            "alt"
          ],
          "additionalProperties": false
        },
        "transition": {
          "$ref": "#/definitions/MaskFocusTransition"
        }
      },
      "required": [
        "type",
        "position",
        "shape",
        "content"
      ],
      "additionalProperties": false
    },
    "CardFrame": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "flow": { "type": "string", "enum": ["normal", "overlay", "overflow"] },
        "position": { "$ref": "#/definitions/Position" },
        "type": { "type": "string", "const": "card" },
        "cardType": { "type": "string", "const": "standard" },
        "asset": { "$ref": "#/definitions/Asset" },
        "alt": { "type": "string", "minLength": 1 },
        "aspectRatio": { "type": "number", "exclusiveMinimum": 0 },
        "cardGeometry": {
          "type": "object",
          "properties": {
            "artWindow": {
              "type": "object",
              "properties": {
                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                "y": { "type": "number", "minimum": 0, "maximum": 1 },
                "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
              },
              "required": ["x", "y", "width", "height"],
              "additionalProperties": false
            }
          },
          "required": ["artWindow"],
          "additionalProperties": false
        }
      },
      "required": ["type", "cardType", "asset", "alt", "aspectRatio", "cardGeometry"],
      "additionalProperties": false
    }
  }
}
