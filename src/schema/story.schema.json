{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoryDocument",
  "description": "Scrolltastic Story Language 5. Unsupported capabilities are rejected.",
  "type": "object",
  "properties": {
    "body": {
      "$ref": "#/definitions/Body"
    },
    "storyLanguage": {
      "const": "5",
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "direction": {
      "enum": [
        "ltr",
        "rtl",
        "auto"
      ]
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RootBeat"
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2000
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    }
  },
  "required": [
    "storyLanguage",
    "id",
    "title",
    "body"
  ],
  "additionalProperties": false,
  "definitions": {
    "ElementBeat": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "offset": {
          "type": "string",
          "pattern": "^(0|-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:px|rem|vw|vh|svh|dvh))$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "TimelineBeat": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "progress"
      ],
      "additionalProperties": false
    },
    "TimelineBeats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/TimelineBeat"
      }
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "Length": {
      "type": "string",
      "pattern": "^(?:0|(?:[0-9]+(?:\\.[0-9]+)?)(?:px|rem|vw|vh|svh|dvh))$"
    },
    "Size": {
      "type": "string",
      "pattern": "^(?:0|(?:[0-9]+(?:\\.[0-9]+)?)(?:px|rem|vw|vh|svh|dvh|%))$"
    },
    "Offset": {
      "type": "string",
      "pattern": "^(?:0|-?(?:[0-9]+(?:\\.[0-9]+)?)(?:px|rem|vw|vh|svh|dvh|%))$"
    },
    "Asset": {
      "type": "string",
      "pattern": "^(?:assets|cards)/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(?:svg|png|jpg|jpeg|webp|avif)$"
    },
    "Position": {
      "type": "object",
      "properties": {
        "anchor": {
          "type": "string",
          "enum": [
            "top-left",
            "top",
            "top-right",
            "left",
            "center",
            "right",
            "bottom-left",
            "bottom",
            "bottom-right"
          ]
        },
        "x": {
          "$ref": "#/definitions/Offset"
        },
        "y": {
          "$ref": "#/definitions/Offset"
        },
        "width": {
          "$ref": "#/definitions/Size"
        },
        "height": {
          "anyOf": [
            {
              "$ref": "#/definitions/Size"
            },
            {
              "type": "string",
              "const": "auto"
            }
          ]
        },
        "z": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "anchor"
      ],
      "additionalProperties": false
    },
    "Height": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto",
            "content",
            "viewport"
          ]
        },
        {
          "$ref": "#/definitions/HeightObject"
        }
      ]
    },
    "BackgroundFrame": {
      "type": "object",
      "properties": {
        "beat": {
          "$ref": "#/definitions/ElementBeat"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "flow": {
          "type": "string",
          "const": "overlay"
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "type": {
          "type": "string",
          "const": "background"
        },
        "fit": {
          "type": "string",
          "enum": [
            "cover",
            "contain"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ]
        },
        "typography": {
          "$ref": "#/definitions/Typography"
        },
        "color": {
          "$ref": "#/definitions/Colour"
        },
        "src": {
          "$ref": "#/definitions/Asset"
        }
      },
      "required": [
        "type",
        "src"
      ],
      "additionalProperties": false
    },
    "ImageFrame": {
      "type": "object",
      "properties": {
        "beat": {
          "$ref": "#/definitions/ElementBeat"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "flow": {
          "type": "string",
          "enum": [
            "normal",
            "overlay",
            "overflow"
          ]
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "type": {
          "type": "string",
          "const": "image"
        },
        "alt": {
          "type": "string"
        },
        "aspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fit": {
          "type": "string",
          "enum": [
            "contain",
            "cover",
            "width"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ]
        },
        "typography": {
          "$ref": "#/definitions/Typography"
        },
        "color": {
          "$ref": "#/definitions/Colour"
        },
        "src": {
          "$ref": "#/definitions/Asset"
        },
        "decorative": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "src"
      ],
      "additionalProperties": false
    },
    "NarrativeFrame": {
      "type": "object",
      "properties": {
        "beat": {
          "$ref": "#/definitions/ElementBeat"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "flow": {
          "type": "string",
          "enum": [
            "normal",
            "overlay",
            "overflow"
          ]
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "type": {
          "type": "string",
          "const": "narrative"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "shape": {
          "type": "string",
          "enum": [
            "rectangle",
            "parallelogram",
            "torn-ribbon"
          ]
        },
        "scrollAnimation": {
          "$ref": "#/definitions/RevealAnimation"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ]
        },
        "typography": {
          "$ref": "#/definitions/Typography"
        },
        "color": {
          "$ref": "#/definitions/Colour"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "DialogueFrame": {
      "type": "object",
      "properties": {
        "beat": {
          "$ref": "#/definitions/ElementBeat"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "flow": {
          "type": "string",
          "enum": [
            "normal",
            "overlay",
            "overflow"
          ]
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "type": {
          "type": "string",
          "const": "dialogue"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scrollAnimation": {
          "$ref": "#/definitions/RevealAnimation"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ]
        },
        "typography": {
          "$ref": "#/definitions/Typography"
        },
        "color": {
          "$ref": "#/definitions/Colour"
        },
        "speaker": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "dialogueStyle": {
          "type": "string",
          "enum": [
            "spoken",
            "thought"
          ]
        },
        "bubble": {
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "enum": [
                "oval",
                "cloud"
              ]
            }
          },
          "required": [
            "shape"
          ],
          "additionalProperties": false
        },
        "tail": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "direction": {
              "type": "string",
              "enum": [
                "top-left",
                "top",
                "top-right",
                "right",
                "bottom-right",
                "bottom",
                "bottom-left",
                "left"
              ]
            },
            "style": {
              "type": "string",
              "enum": [
                "triangle",
                "circle-chain"
              ]
            }
          },
          "additionalProperties": false
        },
        "chain": {
          "type": "object",
          "properties": {
            "next": {
              "$ref": "#/definitions/Id"
            },
            "connector": {
              "type": "string",
              "enum": [
                "bridge",
                "line",
                "bubble-chain",
                "none"
              ]
            }
          },
          "required": [
            "next"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "SoundEffectFrame": {
      "type": "object",
      "properties": {
        "beat": {
          "$ref": "#/definitions/ElementBeat"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "flow": {
          "type": "string",
          "enum": [
            "normal",
            "overlay",
            "overflow"
          ]
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "type": {
          "type": "string",
          "const": "sound-effect"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "style": {
          "type": "string",
          "enum": [
            "burst",
            "impact",
            "motion",
            "rumble",
            "electronic",
            "ambient"
          ]
        },
        "scrollAnimation": {
          "$ref": "#/definitions/RevealAnimation"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ]
        },
        "typography": {
          "$ref": "#/definitions/Typography"
        },
        "color": {
          "$ref": "#/definitions/Colour"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "Frame": {
      "oneOf": [
        {
          "$ref": "#/definitions/BackgroundFrame"
        },
        {
          "$ref": "#/definitions/ImageFrame"
        },
        {
          "$ref": "#/definitions/NarrativeFrame"
        },
        {
          "$ref": "#/definitions/DialogueFrame"
        },
        {
          "$ref": "#/definitions/SoundEffectFrame"
        },
        {
          "$ref": "#/definitions/MaskFrame"
        },
        {
          "$ref": "#/definitions/CardFrame"
        }
      ],
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      }
    },
    "Panel": {
      "type": "object",
      "properties": {
        "beat": {
          "$ref": "#/definitions/ElementBeat"
        },
        "type": {
          "type": "string",
          "const": "panel"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "height": {
          "$ref": "#/definitions/Height"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Frame"
          },
          "minItems": 1
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ]
        },
        "typography": {
          "$ref": "#/definitions/Typography"
        },
        "color": {
          "$ref": "#/definitions/Colour"
        },
        "background": {
          "$ref": "#/definitions/Colour"
        },
        "padding": {
          "enum": [
            "none",
            "small",
            "medium",
            "large"
          ]
        },
        "gap": {
          "enum": [
            "none",
            "small",
            "medium",
            "large"
          ]
        },
        "radius": {
          "enum": [
            "none",
            "small",
            "medium",
            "large"
          ]
        },
        "border": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color"
          ],
          "properties": {
            "color": {
              "$ref": "#/definitions/Colour"
            },
            "width": {
              "enum": [
                "thin",
                "medium",
                "thick"
              ]
            }
          }
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "overflow": {
          "enum": [
            "visible",
            "hidden"
          ]
        }
      },
      "required": [
        "type",
        "id",
        "frames"
      ],
      "additionalProperties": false
    },
    "Space": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "space"
        },
        "height": {
          "$ref": "#/definitions/Length"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "type",
        "height"
      ],
      "additionalProperties": false
    },
    "Container": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "container"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "seam": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "seamless"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "flow": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/Panel"
              },
              {
                "$ref": "#/definitions/Space"
              }
            ],
            "type": "object",
            "discriminator": {
              "propertyName": "type"
            }
          },
          "minItems": 1
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ]
        },
        "typography": {
          "$ref": "#/definitions/Typography"
        },
        "color": {
          "$ref": "#/definitions/Colour"
        }
      },
      "required": [
        "type",
        "id",
        "flow"
      ],
      "additionalProperties": false
    },
    "Body": {
      "type": "object",
      "properties": {
        "interaction": {
          "type": "object",
          "properties": {
            "advance": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "mode": {
                  "const": "beats"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "controls",
                      "keyboard",
                      "flip",
                      "tap"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true,
                  "contains": {
                    "const": "controls"
                  },
                  "description": "Defaults to controls only. Visible controls are required; keyboard, Flip and tap are optional."
                }
              },
              "required": [
                "enabled",
                "mode"
              ],
              "additionalProperties": false
            },
            "scroll": {
              "type": "object",
              "properties": {
                "snap": {
                  "enum": [
                    "none",
                    "beats"
                  ]
                }
              },
              "required": [
                "snap"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "advance"
          ],
          "additionalProperties": false
        },
        "orientation": {
          "type": "string",
          "const": "portrait"
        },
        "motion": {
          "type": "object",
          "properties": {
            "reducedMotion": {
              "type": "string",
              "const": "respect-system"
            }
          },
          "required": [
            "reducedMotion"
          ],
          "additionalProperties": false
        },
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Container"
          },
          "minItems": 1
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ]
        },
        "typography": {
          "$ref": "#/definitions/Typography"
        },
        "color": {
          "$ref": "#/definitions/Colour"
        },
        "background": {
          "$ref": "#/definitions/Colour"
        }
      },
      "required": [
        "containers"
      ],
      "additionalProperties": false
    },
    "RevealAnimation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "reveal"
        },
        "start": {
          "type": "string",
          "enum": [
            "top bottom",
            "top 90%",
            "top 82%",
            "top 70%",
            "top 55%",
            "top center"
          ]
        },
        "end": {
          "type": "string",
          "enum": [
            "top 90%",
            "top 82%",
            "top 70%",
            "top 55%",
            "top center",
            "bottom top"
          ]
        },
        "from": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "yPercent": {
              "type": "number",
              "minimum": -12,
              "maximum": 12
            },
            "scale": {
              "type": "number",
              "minimum": 0.9,
              "maximum": 1.1
            }
          }
        }
      },
      "required": [
        "type"
      ]
    },
    "MaskShape": {
      "oneOf": [
        {
          "$ref": "#/definitions/EllipseMaskShape"
        },
        {
          "$ref": "#/definitions/RoundedRectMaskShape"
        },
        {
          "$ref": "#/definitions/PolygonMaskShape"
        }
      ],
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      }
    },
    "EllipseMaskShape": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ellipse"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "RoundedRectMaskShape": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "rounded-rect"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "PolygonMaskShape": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "polygon"
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "required": [
        "type",
        "points"
      ],
      "additionalProperties": false
    },
    "MaskFocusTransition": {
      "type": "object",
      "properties": {
        "beats": {
          "$ref": "#/definitions/TimelineBeats"
        },
        "type": {
          "type": "string",
          "const": "pull-focus"
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "MaskFrame": {
      "type": "object",
      "properties": {
        "beat": {
          "$ref": "#/definitions/ElementBeat"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "flow": {
          "type": "string",
          "const": "overlay"
        },
