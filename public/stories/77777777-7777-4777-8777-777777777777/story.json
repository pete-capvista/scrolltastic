        "frames": [
          { "type": "narrative", "id": "plain-narrative", "shape": "rectangle", "text": "The lake had fallen silent." },
          { "type": "narrative", "id": "urgent-narrative", "shape": "parallelogram", "text": "Then the warning crossed the water." },
          { "type": "narrative", "id": "torn-narrative", "shape": "torn-ribbon", "text": "DO NOT FOLLOW THE LIGHTS" },
          {
            "type": "dialogue",
            "id": "dialogue-one",
            "speaker": "Mira",
            "text": "I've seen this place before.",
            "chain": { "next": "dialogue-two", "connector": "bridge" }
          },
          {
            "type": "dialogue",
            "id": "dialogue-two",
            "speaker": "Mira",
            "text": "But something is different now.",
            "tail": { "direction": "bottom-right" }
          },
          {
            "type": "dialogue",
            "id": "thought",
            "speaker": "Mira",
            "dialogueStyle": "thought",
            "text": "Where did everyone go?"
          },
          { "type": "sound-effect", "id": "impact", "style": "burst", "text": "CRASH!" },
          { "type": "sound-effect", "id": "movement", "style": "motion", "text": "WHOOSH!" }
        ]
      }]
